# Firebase (Push notifications)
FCM_SERVER_KEY=""

# AWS S3
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
AWS_REGION="eu-west-1"

# Sentry
SENTRY_DSN=""

# Platform fee tiers (all amounts in NGN, thresholds inclusive at upper bound)
# Tier 1: contribution <= TIER_1_MAX → TIER_1_AMOUNT fee
# Tier 2: contribution <= TIER_2_MAX → TIER_2_AMOUNT fee
# Tier 3: contribution >  TIER_2_MAX → TIER_3_AMOUNT fee
# Note: bearer="customer" is set on all Paystack transactions — Paystack's
# processing fee is charged to the customer on top, so these amounts are pure profit.
CONTRIBUTION_FEE_TIER_1_MAX=10000
CONTRIBUTION_FEE_TIER_1_AMOUNT=0
CONTRIBUTION_FEE_TIER_2_MAX=50000
CONTRIBUTION_FEE_TIER_2_AMOUNT=0
CONTRIBUTION_FEE_TIER_3_AMOUNT=1800
# Fraction of each fee deposited to the protection reserve (0.20 = 20%)
RESERVE_CONTRIBUTION_PERCENTAGE=0.20
# Late payment penalty percentage applied to overdue contributions (default 5%)
PENALTY_PERCENTAGE_DEFAULT=5

# Public web app origin — used for payment and debt-clearance callback URLs
FRONTEND_URL="https://app.poolr.ng"

# App
NODE_ENV="development"
PORT=3002
