{
  "name": "@poolr/database",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev --name init",
    "db:push": "dotenv -e ../../.env -- prisma db push",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "lint": "eslint . --ext .ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@poolr/eslint-config": "workspace:*",
    "@poolr/typescript-config": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.0.0",
    "dotenv-cli": "^8.0.0",
    "prisma": "^7.8.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3"
  }
}
