generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  INACTIVE
  SUSPENDED
  FROZEN
  BANNED
}

enum DebtStatus {
  OUTSTANDING
  PARTIAL
  CLEARED
}

enum BanReason {
  RECEIVED_PAYOUT_THEN_DEFAULTED
  MANUAL_ADMIN_BAN
}

enum KycStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum GroupStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum Frequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum Currency {
  NGN
}

enum MemberStatus {
  INVITED
  ACTIVE
  LEFT
  REMOVED
}

enum CycleStatus {
  PENDING
  ACTIVE
  COMPLETED
  OVERDUE
}

enum ContribStatus {
  PENDING
  PAID
  OVERDUE
  WAIVED
}

enum PayoutStatus {
  PENDING
  INITIATED
  COMPLETED
  FAILED
}

enum PenaltyStatus {
  PENDING
  APPLIED
  WAIVED
}

enum PenaltyReason {
  LATE_PAYMENT
  MISSED_PAYMENT
  INSUFFICIENT_FUNDS
}

enum TxDirection {
  CREDIT
  DEBIT
}

enum TxType {
  CONTRIBUTION
  PAYOUT
  PENALTY
  TOPUP
  WITHDRAWAL
  REVERSAL
}

enum NotifChannel {
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum NotifStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum PaymentSource {
  PAYSTACK
  WALLET
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  fullName     String     @map("full_name")
  email        String     @unique
  phone        String     @unique
  passwordHash String     @map("password_hash")
  avatarUrl    String?    @map("avatar_url")
  fcmToken     String?    @map("fcm_token")
  role         Role       @default(USER)
  status       UserStatus @default(PENDING_VERIFICATION)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  kycProfile        KycProfile?
  bankAccount       BankAccount?
  groupsAdminOf     Group[]        @relation("GroupAdmin")
  groupMemberships  GroupMember[]
  cyclesAsRecipient Cycle[]        @relation("CycleRecipient")
  payoutsReceived   Payout[]       @relation("PayoutRecipient")
  wallet            Wallet?
  notifications     Notification[]
  contributionFees  ContributionFee[]
  debts             Debt[]
  banRecords        BanRecord[]
  flaggedIdentity   FlaggedIdentity?

  @@map("users")
}

model KycProfile {
  id         String    @id @default(cuid())
  userId     String    @unique @map("user_id")
  bvn         String?
  nin         String?
  selfieUrl   String?   @map("selfie_url")
  idDocUrl    String?   @map("id_doc_url")
  kycAttempts Int       @default(0) @map("kyc_attempts")
  kycStatus  KycStatus @default(PENDING) @map("kyc_status")
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("kyc_profiles")
}

model Group {
  id                 String      @id @default(cuid())
  adminId            String      @map("admin_id")
  name               String
  contributionAmount Decimal     @map("contribution_amount") @db.Decimal(12, 2)
  currency           Currency    @default(NGN)
  frequency          Frequency
  maxMembers         Int         @map("max_members")
  status             GroupStatus @default(DRAFT)
  startDate          DateTime?   @map("start_date")
  penaltyConfig      Json?       @map("penalty_config")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  admin        User          @relation("GroupAdmin", fields: [adminId], references: [id])
  members      GroupMember[]
  cycles       Cycle[]
  groupAccount GroupAccount?

  @@map("groups")
}

model GroupAccount {
  id                   String   @id @default(cuid())
  groupId              String   @unique @map("group_id")
  paystackCustomerCode String   @map("paystack_customer_code")
  accountNumber        String   @map("account_number")
  accountName          String   @map("account_name")
  bankName             String   @map("bank_name")
  createdAt            DateTime @default(now()) @map("created_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("group_accounts")
}

model GroupMember {
  id               String       @id @default(cuid())
  groupId          String       @map("group_id")
  userId           String       @map("user_id")
  rotationPosition Int          @map("rotation_position")
  memberStatus     MemberStatus @default(INVITED) @map("member_status")
  joinedAt         DateTime     @default(now()) @map("joined_at")

  groupTermsAcceptedAt DateTime? @map("group_terms_accepted_at")

  group         Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions Contribution[]
  penalties     Penalty[]

  @@unique([groupId, userId])
  @@unique([groupId, rotationPosition])
  @@map("group_members")
}

model Cycle {
  id          String      @id @default(cuid())
  groupId     String      @map("group_id")
  recipientId String      @map("recipient_id")
  cycleNumber Int         @map("cycle_number")
  dueDate     DateTime    @map("due_date")
  payoutDate  DateTime?   @map("payout_date")
  status      CycleStatus @default(PENDING)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  payoutHeld       Boolean  @default(false) @map("payout_held")
  payoutHeldReason String?  @map("payout_held_reason")

  group         Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  recipient     User           @relation("CycleRecipient", fields: [recipientId], references: [id])
  contributions Contribution[]
  payouts       Payout[]
  debts         Debt[]

  @@unique([groupId, cycleNumber])
  @@map("cycles")
}

model Contribution {
  id            String        @id @default(cuid())
  cycleId       String        @map("cycle_id")
  memberId      String        @map("member_id")
  amount        Decimal       @db.Decimal(12, 2)
  feeAmount     Decimal?      @db.Decimal(12, 2) @map("fee_amount")
  totalCharged  Decimal?      @db.Decimal(12, 2) @map("total_charged")
  status        ContribStatus @default(PENDING)
  paymentSource PaymentSource @default(PAYSTACK) @map("payment_source")
  paystackRef   String?       @map("paystack_ref")
  paidAt        DateTime?     @map("paid_at")
  dueAt         DateTime      @map("due_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  cycle           Cycle            @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  member          GroupMember      @relation(fields: [memberId], references: [id])
  penalties       Penalty[]
  contributionFee ContributionFee?

  @@unique([cycleId, memberId])
  @@map("contributions")
}

model ContributionFee {
  id                 String   @id @default(cuid())
  contributionId     String   @unique @map("contribution_id")
  userId             String   @map("user_id")
  contributionAmount Decimal  @db.Decimal(12, 2) @map("contribution_amount")
  feeAmount          Decimal  @db.Decimal(12, 2) @map("fee_amount")
  reserveAmount      Decimal  @db.Decimal(12, 2) @map("reserve_amount")
  revenueAmount      Decimal  @db.Decimal(12, 2) @map("revenue_amount")
  createdAt          DateTime @default(now()) @map("created_at")

  contribution Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@map("contribution_fees")
}

model Payout {
  id                   String       @id @default(cuid())
  cycleId              String       @map("cycle_id")
  recipientId          String       @map("recipient_id")
  amount               Decimal      @db.Decimal(12, 2)
  status               PayoutStatus @default(PENDING)
  paystackTransferCode String?      @map("paystack_transfer_code")
  initiatedAt          DateTime?    @map("initiated_at")
  completedAt          DateTime?    @map("completed_at")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  cycle     Cycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  recipient User  @relation("PayoutRecipient", fields: [recipientId], references: [id])

  @@map("payouts")
}

model Penalty {
  id             String        @id @default(cuid())
  contributionId String        @map("contribution_id")
  memberId       String        @map("member_id")
  penaltyAmount  Decimal       @map("penalty_amount") @db.Decimal(12, 2)
  reason         PenaltyReason
  status         PenaltyStatus @default(PENDING)
  appliedAt      DateTime?     @map("applied_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  contribution Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  member       GroupMember  @relation(fields: [memberId], references: [id])

  @@map("penalties")
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  currency  Currency @default(NGN)
  version   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id        String      @id @default(cuid())
  walletId  String      @map("wallet_id")
  amount    Decimal     @db.Decimal(12, 2)
  type      TxType
  direction TxDirection
  reference String      @unique
  createdAt DateTime    @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("wallet_transactions")
}

model BankAccount {
  id                    String   @id @default(cuid())
  userId                String   @unique @map("user_id")
  bankCode              String   @map("bank_code")
  bankName              String   @map("bank_name")
  accountNumber         String   @map("account_number")
  accountName           String   @map("account_name")
  paystackRecipientCode String   @map("paystack_recipient_code")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("bank_accounts")
}

model Notification {
  id        String       @id @default(cuid())
  userId    String       @map("user_id")
  title     String
  body      String
  channel   NotifChannel
  status    NotifStatus  @default(PENDING)
  isRead    Boolean      @default(false) @map("is_read")
  readAt    DateTime?    @map("read_at")
  sentAt    DateTime?    @map("sent_at")
  createdAt DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model FlaggedIdentity {
  id            String   @id @default(cuid())
  userId        String   @unique @map("user_id")
  bvnHash       String?  @map("bvn_hash")
  ninHash       String?  @map("nin_hash")
  flaggedAt     DateTime @default(now()) @map("flagged_at")
  flaggedReason String   @map("flagged_reason")

  user User @relation(fields: [userId], references: [id])

  @@map("flagged_identities")
}

model Debt {
  id            String     @id @default(cuid())
  userId        String     @map("user_id")
  cycleId       String     @map("cycle_id")
  amountNgn     Decimal    @db.Decimal(12, 2) @map("amount_ngn")
  status        DebtStatus @default(OUTSTANDING)
  paymentLink   String?    @map("payment_link")
  paymentRef    String?    @unique @map("payment_ref")
  clearedAt     DateTime?  @map("cleared_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id])
  cycle Cycle @relation(fields: [cycleId], references: [id])

  @@map("debts")
}

model BanRecord {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  reason      BanReason
  bannedAt    DateTime  @default(now()) @map("banned_at")
  bannedByAdminId String? @map("banned_by_admin_id")
  notes       String?

  user User @relation(fields: [userId], references: [id])

  @@map("ban_records")
}
